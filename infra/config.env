# pinned versions and VM sizing; identical across all scenarios
K3S_VERSION="v1.36.5+k3s1"
CILIUM_VERSION="1.20.3"
ISTIO_VERSION="1.30.7"
LIMA_TEMPLATE="template:ubuntu-24.04"

NODES="zt-cp zt-w1 zt-w2"
CP_NODE="zt-cp"
VM_CPUS=4
VM_MEMORY_GIB=8
VM_DISK_GIB=30
# socket_vmnet shared network: VMs reach each other and the host (vzNAT isolates VMs from each other)
VM_NETWORK="lima:shared"
NODE_IFACE="lima0"

KUBECONFIG_PATH=".kube/config"
