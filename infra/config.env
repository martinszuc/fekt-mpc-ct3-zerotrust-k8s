# pinned versions and VM sizing; identical across all scenarios
K3S_VERSION="v1.36.5+k3s1"
CILIUM_VERSION="1.20.3"
ISTIO_VERSION="1.30.7"
# Ubuntu 24.04 image pinned by release date and digest (infra/lima-ubuntu.yaml)
LIMA_TEMPLATE="infra/lima-ubuntu.yaml"
# k3s install script from the same tag as the binary, not the moving get.k3s.io
K3S_INSTALL_URL="https://raw.githubusercontent.com/k3s-io/k3s/${K3S_VERSION//+/%2B}/install.sh"
# guest kernel, identical on every node (infra/vm-prep.sh); automatic apt runs are off
KERNEL_VERSION=${KERNEL_VERSION:-6.8.0-147-generic}

# nodes as node_exec reaches them (Lima VM names); app and benchmarks are pinned to W1 and W2
CP_NODE=${CP_NODE:-zt-cp}
W1_NODE=${W1_NODE:-zt-w1}
W2_NODE=${W2_NODE:-zt-w2}
NODES=${NODES:-"$CP_NODE $W1_NODE $W2_NODE"}
VM_CPUS=4
VM_MEMORY_GIB=8
VM_DISK_GIB=30
# defaults are the tested macOS setup; the overrides are for other hosts (README, Other platforms)
VM_TYPE=${VM_TYPE:-vz}
VM_ARCH=${VM_ARCH:-aarch64}
# socket_vmnet shared network: VMs reach each other and the host (vzNAT isolates VMs from each other)
VM_NETWORK=${VM_NETWORK:-lima:shared}
NODE_IFACE=${NODE_IFACE:-lima0}
# k3s default pod CIDR (cluster-cidr), used by the sniffing test to find unencrypted pod frames
POD_CIDR=${POD_CIDR:-10.42.0.0/16}

# how scripts reach a node shell (infra/node.sh): lima, ssh or docker
NODE_EXEC=${NODE_EXEC:-lima}
# Kubernetes node name = NODE_PREFIX + node; Lima sets the guest hostname to lima-<vm>
if [[ $NODE_EXEC == lima ]]; then NODE_PREFIX=${NODE_PREFIX-lima-}; else NODE_PREFIX=${NODE_PREFIX-}; fi

KUBECONFIG_PATH=".kube/config"
