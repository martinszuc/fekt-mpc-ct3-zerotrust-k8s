# node access for the kind cluster (infra/kind.yaml); source before make app, make s*, make test
export NODE_EXEC=docker
export NODE_IFACE=eth0
export CP_NODE=zt-control-plane
export W1_NODE=zt-worker
export W2_NODE=zt-worker2
# kind default podSubnet (k3s: 10.42.0.0/16); no trailing comments: CI copies these lines into $GITHUB_ENV
export POD_CIDR=10.244.0.0/16
